#include "SevSeg.h"

SevSeg display;
byte commonPins[] = {};
byte segmentPins[] = {2, 3, 4, 5, 6, 7, 8};
const int buttonPins[] = {9, 10, 11, 12};
int count = 0;

void setup() {
  display.begin(COMMON_CATHODE, 1, commonPins, segmentPins, 1);

  for (int i = 0; i < 4; i++) {
    pinMode(buttonPins[i], INPUT_PULLUP);
  }
}

void loop() {
  count = 0;

  for (int i = 0; i < 4; i++) {
    if (digitalRead(buttonPins[i]) == LOW) {
      count |= (1 << i);
    }
  }

  display.setNumber(count);
  display.refreshDisplay();
  delay(50);
}